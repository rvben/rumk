# Generated by Cargo
# will have compiled files and executables
debug/
target/
dist/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test coverage
*.profraw
*.profdata
coverage/

# Benchmark results
*.bench

# Python verification scripts
__pycache__/

# Local configuration
.rumk.toml
rumk.toml

# Environment variables (secrets)
.env

# Private local audits, benchmark results, comparison reports, and review notes.
# Ignore the entire directory, including hand-written reports and review labels.
/reports/
# Former private-report locations must not be reintroduced into source control.
/docs/linter-comparison.md
/scripts/corpus-review.json
