{
  "schema_version": 1,
  "cases": [
    {
      "name": "duplicate-recipe",
      "title": "A second recipe silently replaces the first",
      "dialect": "GNU Make",
      "rule": "MK204",
      "files": {
        "source.txt": "input\n"
      },
      "args": [
        "probe"
      ],
      "broken": "probe:\n\t@echo expected\n\nprobe:\n\t@echo replaced\n",
      "working": "probe: source.txt\nprobe:\n\t@echo expected\n",
      "oracle": {
        "broken": {
          "exit_code": 0,
          "stdout": "replaced\n",
          "stderr_contains": "overriding"
        },
        "working": {
          "exit_code": 0,
          "stdout": "expected\n",
          "stderr_absent": "overriding"
        }
      },
      "matchers": {
        "checkmake": "uniquetargets",
        "mbake": "Error: Duplicate target 'probe'"
      },
      "safe_fix": "withheld",
      "expected_rumk_detection": true
    },
    {
      "name": "dependency-cycle",
      "title": "Make discards a circular dependency",
      "dialect": "GNU Make",
      "rule": "MK205",
      "files": {},
      "args": [
        "probe"
      ],
      "broken": "probe: helper\n\t@echo probe\nhelper: probe\n\t@echo helper\n",
      "working": "probe: helper\n\t@echo probe\nhelper:\n\t@echo helper\n",
      "oracle": {
        "broken": {
          "exit_code": 0,
          "stdout": "helper\nprobe\n",
          "stderr_contains": "Circular"
        },
        "working": {
          "exit_code": 0,
          "stdout": "helper\nprobe\n",
          "stderr_absent": "Circular"
        }
      },
      "matchers": {},
      "safe_fix": "withheld",
      "expected_rumk_detection": true
    },
    {
