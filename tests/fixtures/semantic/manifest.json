        "working": {
          "exit_code": 2,
          "stderr_contains": "Error"
        }
      },
      "matchers": {
        "unmake": ": GLOBAL_IGNORE:",
        "mbake": "Special target '\\.IGNORE'.*requires prerequisites"
      },
      "safe_fix": "withheld",
      "expected_rumk_detection": true
    },
    {
      "name": "late-expansion",
      "title": "An immediate assignment reads a value too early",
      "dialect": "GNU Make",
      "rule": "MK208",
      "files": {},
      "args": [
        "probe"
      ],
      "broken": "VALUE := $(LATER)\nLATER := expected\nprobe:\n\t@printf \"<%s>\\n\" \"$(VALUE)\"\n",
      "working": "LATER := expected\nVALUE := $(LATER)\nprobe:\n\t@printf \"<%s>\\n\" \"$(VALUE)\"\n",
      "oracle": {
        "broken": {
          "exit_code": 0,
          "stdout": "<>\n"
        },
        "working": {
          "exit_code": 0,
          "stdout": "<expected>\n"
        }
      },
      "matchers": {},
      "safe_fix": "withheld",
      "expected_rumk_detection": true
    },
    {
      "name": "recipe-indentation",
      "title": "Spaces prevent a recipe from parsing",
      "dialect": "GNU Make",
      "rule": "MK001",
      "files": {},
      "args": [
        "probe"
      ],
      "broken": "probe:\n    @echo expected\n",
      "working": "probe:\n\t@echo expected\n",
      "oracle": {
        "broken": {
          "exit_code": 2,
          "stderr_contains": "missing separator"
        },
        "working": {
          "exit_code": 0,
          "stdout": "expected\n"
        }
      },
      "matchers": {
        "unmake": "error: Makefile:2:1.*expected:.*\\\\t"
      },
      "safe_fix": "repair",
      "expected_rumk_detection": true
    },
    {
      "name": "phony-collision",
      "title": "A file named test suppresses the command",
      "dialect": "GNU Make",
      "rule": "MK201",
      "files": {
        "test": "existing file\n"
      },
      "args": [
        "test"
      ],
      "broken": "test:\n\t@echo verified\n",
      "working": ".PHONY: test\ntest:\n\t@echo verified\n",
      "oracle": {
        "broken": {
          "exit_code": 0,
          "stdout_absent": "verified"
        },
        "working": {
          "exit_code": 0,
          "stdout": "verified\n"
        }
      },
      "matchers": {
        "checkmake": "phonydeclared",
        "unmake": ": PHONY[^:]*:",
        "mbake": "Consider adding \\.PHONY declaration.*test"
      },
      "safe_fix": "withheld",
      "expected_rumk_detection": true
    },
