      "safe_fix": "withheld",
      "expected_rumk_detection": true
    },
    {
      "name": "recursive-dry-run",
      "title": "A direct make command hides child dry-run output",
      "dialect": "GNU Make",
      "rule": "MK203",
      "files": {
        "child.mk": "child:\n\t@echo child-command\n"
      },
      "args": [
        "-n",
        "probe"
      ],
      "broken": "probe:\n\t@make -f child.mk child\n",
      "working": "probe:\n\t@$(MAKE) -f child.mk child\n",
      "oracle": {
        "broken": {
          "exit_code": 0,
          "stdout_absent": "echo child-command"
        },
        "working": {
          "exit_code": 0,
          "stdout_contains": "echo child-command"
        }
      },
      "matchers": {
        "unmake": ": MAKE_NOP:"
      },
      "safe_fix": "withheld",
      "expected_rumk_detection": true
    },
    {
      "name": "lost-directory",
      "title": "A new recipe shell loses the previous directory",
      "dialect": "GNU Make",
      "rule": "MK212",
      "files": {
        "marker": "root\n",
        "work/marker": "child\n"
      },
      "args": [
        "probe"
      ],
      "broken": "probe:\n\t@cd work\n\t@cat marker\n",
      "working": "probe:\n\t@cd work && cat marker\n",
      "oracle": {
        "broken": {
          "exit_code": 0,
          "stdout": "root\n"
        },
        "working": {
          "exit_code": 0,
          "stdout": "child\n"
        }
      },
      "matchers": {
        "unmake": ": WD_NOP:"
      },
      "safe_fix": "withheld",
      "expected_rumk_detection": true
    },
    {
      "name": "global-ignore",
      "title": "Global suppression lets a failed build succeed",
      "dialect": "GNU Make",
      "rule": "MK214",
      "files": {},
      "args": [
        "probe"
      ],
      "broken": ".IGNORE:\nprobe:\n\t@false\n",
      "working": "probe:\n\t@false\n",
      "oracle": {
        "broken": {
          "exit_code": 0,
          "stdout": "",
          "stderr_contains": "ignored"
